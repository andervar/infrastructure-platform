# {{ ansible_managed }}
# Redis configuration generated by Ansible

# ============================================
# NETWORK
# ============================================
bind {{ redis.bind | join(' ') }}
port {{ redis.port }}
protected-mode {{ redis.protected_mode }}

# ============================================
# SECURITY
# ============================================
requirepass {{ vault_redis_password }}

{% for cmd, alias in redis.rename_commands.items() %}
rename-command {{ cmd }} "{{ alias }}"
{% endfor %}

# ============================================
# PERSISTENCE (RDB snapshots)
# ============================================
{% for save_rule in redis.save %}
save {{ save_rule }}
{% endfor %}

dir {{ redis.dir }}

# ============================================
# MEMORY
# ============================================
maxmemory {{ redis.maxmemory }}
maxmemory-policy {{ redis.maxmemory_policy }}

# ============================================
# LOGGING
# ============================================
loglevel {{ redis.loglevel }}
logfile {{ redis.logfile }}