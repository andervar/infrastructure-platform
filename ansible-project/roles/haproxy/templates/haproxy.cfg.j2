# {{ ansible_managed }}
# HAProxy configuration generated by Ansible

global
    log /dev/log local0
    log /dev/log local1 notice
    daemon
    maxconn {{ haproxy.global.maxconn | default(4000) }}
    user {{ haproxy.global.user | default('haproxy') }}
    group {{ haproxy.global.group | default('haproxy') }}
    ca-base {{ haproxy.global.ca_base | default('/etc/ssl/certs') }}
    crt-base {{ haproxy.global.crt_base | default('/etc/ssl/private') }}

defaults
    log     global
    mode    {{ haproxy.defaults.mode | default('http') }}
    option  httplog
    option  dontlognull
    timeout connect {{ haproxy.defaults.timeout_connect | default('5s') }}
    timeout client  {{ haproxy.defaults.timeout_client | default('50s') }}
    timeout server  {{ haproxy.defaults.timeout_server | default('50s') }}
    option forwardfor

#---------------------------------------------------------------------
# FRONTENDS (HTTP to HTTPS redirect)
#---------------------------------------------------------------------
frontend http-in
    bind {{ haproxy.frontends.http.bind | default(':80') }}
    redirect scheme https if !{ ssl_fc }

#---------------------------------------------------------------------
# FRONTENDS HTTPS
#---------------------------------------------------------------------
{% for frontend_name, frontend_config in haproxy.frontends.items() if frontend_name != 'http' %}
frontend {{ frontend_name }}
    bind {{ frontend_config.bind }} ssl crt {{ haproxy.ssl_cert_path }}
    mode http
    option httplog

    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Host %[req.hdr(host)]
    http-request set-header X-Real-IP %[src]

{% if frontend_config.domains is defined %}
{% for backend_name, domain in frontend_config.domains.items() %}
    acl is_{{ backend_name }} hdr(host) -i {{ domain }}
{% endfor %}
{% for backend_name, domain in frontend_config.domains.items() %}
    use_backend {{ backend_name }}_backend if is_{{ backend_name }}
{% endfor %}
{% endif %}
    default_backend {{ frontend_config.default_backend }}_backend

{% endfor %}

#---------------------------------------------------------------------
# BACKENDS
#---------------------------------------------------------------------
{% for backend_name, backend_config in haproxy.backends.items() %}
backend {{ backend_name }}_backend
    mode http
    option httpchk GET {{ backend_config.health_check_path | default('/') }}
    http-check expect status {{ backend_config.health_check_status | default(200) }}
{% for server_name, server_config in backend_config.servers.items() %}
    server {{ server_name }} {{ server_config.address }}:{{ server_config.port }} check inter {{ server_config.check_interval | default('10s') }} fall {{ server_config.fall | default(3) }} rise {{ server_config.rise | default(2) }}
{% endfor %}

{% endfor %}