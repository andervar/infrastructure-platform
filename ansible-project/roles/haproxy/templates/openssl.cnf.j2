# {{ ansible_managed }}
# OpenSSL configuration for HAProxy certificate
# Generated by Ansible for {{ inventory_hostname }}

[req]
distinguished_name = dn
x509_extensions    = v3_req
prompt             = no

[dn]
C  = {{ haproxy_ssl.country }}
ST = {{ haproxy_ssl.state }}
L  = {{ haproxy_ssl.city }}
O  = {{ haproxy_ssl.org }}
OU = {{ haproxy_ssl.ou }}
CN = {{ haproxy_ssl.cn }}
emailAddress = {{ haproxy_ssl.email }}

[v3_req]
keyUsage = keyEncipherment, dataEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[alt_names]
{% set ns = namespace(counter=1) %}
{% for ip in haproxy_ssl.san_ips %}
IP.{{ ns.counter }} = {{ ip }}
{% set ns.counter = ns.counter + 1 %}
{% endfor %}
{% for dns in haproxy_ssl.san_dns %}
DNS.{{ ns.counter }} = {{ dns }}
{% set ns.counter = ns.counter + 1 %}
{% endfor %}