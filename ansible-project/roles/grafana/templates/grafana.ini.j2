[server]
protocol = http
http_addr = {{ grafana_http_addr }}
http_port = {{ grafana_http_port }}
domain = {{ grafana_http_addr }}
root_url = %(protocol)s://%(domain)s:%(http_port)s/

[security]
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}
disable_gravatar = true
cookie_secure = false

[users]
allow_sign_up = false
default_theme = dark

[auth.anonymous]
enabled = false

[auth.ldap]
enabled = true
config_file = /etc/grafana/ldap.toml
allow_sign_up = true

[analytics]
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false

[log]
mode = console file
level = info

[unified_alerting]
enabled = true

[alerting]
enabled = false

{% if grafana_smtp_enabled %}
[smtp]
enabled = true
host = {{ grafana_smtp_host }}
user = {{ grafana_smtp_user }}
password = """{{ grafana_smtp_password }}"""
from_address = {{ grafana_smtp_from_address }}
from_name = {{ grafana_smtp_from_name }}
startTLS_policy = Mandatory
skip_verify = false
ehlo_identity = ucr.ac.cr
{% endif %}
